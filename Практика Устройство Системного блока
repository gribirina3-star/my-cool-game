    <script>
        // Registration Logic
        let studentName = "";
        let studentClass = "";

        function validateForm() {
            studentName = document.getElementById('student-name').value.trim();
            studentClass = document.getElementById('student-class').value.trim();
            const startBtn = document.getElementById('start-btn');

            if (studentName.length >= 3 && studentClass.length >= 1) {
                startBtn.disabled = false;
            } else {
                startBtn.disabled = true;
            }
        }

        function quickSetClass(val) {
            document.getElementById('student-class').value = val;
            validateForm();
        }

        // Game State Variables
        let currentLevel = 1;
        let score = 0;
        let timerSeconds = 20 * 60;
        let timerInterval = null;
        let isPaused = false;

        // Web Audio API Synthesis
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(type) {
            try {
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === 'correct') {
                    osc.frequency.setValueAtTime(523.25, audioCtx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(659.25, audioCtx.currentTime + 0.15);
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.2);
                } else if (type === 'wrong') {
                    osc.frequency.setValueAtTime(220, audioCtx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(130, audioCtx.currentTime + 0.2);
                    gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.22);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.22);
                }
            } catch(e){}
        }

        function startGame() {
            // Update User display info
            document.getElementById('user-info-display').innerText = `Ученик: ${studentName} | Класс: ${studentClass}`;

            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('level-1').classList.remove('hidden');

            timerInterval = setInterval(() => {
                if (!isPaused) {
                    timerSeconds--;
                    updateTimerDisplay();
                    if (timerSeconds <= 0) {
                        clearInterval(timerInterval);
                        finishGame();
                    }
                }
            }, 1000);

            initLevel1();
        }

        function togglePause() {
            isPaused = !isPaused;
            document.getElementById('pause-btn').innerHTML = isPaused ? 
                '<i class="fa-solid fa-play"></i>' : '<i class="fa-solid fa-pause"></i>';
        }

        function updateTimerDisplay() {
            const m = Math.floor(timerSeconds / 60);
            const s = timerSeconds % 60;
            document.getElementById('timer-display').innerText = 
                `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        }

        function addScore(pts) {
            score += pts;
            if (score < 0) score = 0;
            document.getElementById('score-display').innerText = score;
        }

        // LEVEL 1 LOGIC
        let level1Step = 1; 
        let thermalPasteApplied = false;

        const hwItems = [
            { id: "cpu", name: "Процессор (CPU)", step: 1, icon: "fa-microchip", color: "text-emerald-600" },
            { id: "thermal", name: "Термопаста", step: 2, icon: "fa-eye-dropper", color: "text-amber-600" },
            { id: "cooler", name: "Кулер Охлаждения", step: 3, icon: "fa-fan", color: "text-cyan-600" },
            { id: "ram", name: "Модуль ОЗУ DDR5", step: 4, icon: "fa-memory", color: "text-amber-500" },
            { id: "gpu", name: "Видеокарта (GPU)", step: 5, icon: "fa-tv", color: "text-purple-600" },
            { id: "ssd", name: "NVMe M.2 SSD", step: 6, icon: "fa-hard-drive", color: "text-blue-600" },
            { id: "psu", name: "Блок питания (PSU)", step: 7, icon: "fa-plug", color: "text-red-600" },
            { id: "cables", name: "Кабели питания ATX", step: 8, icon: "fa-network-wired", color: "text-gray-700" }
        ];

        function initLevel1() {
            renderHardwareDrawer();
            setupHardwareDropSlots();
        }

        function renderHardwareDrawer() {
            const drawer = document.getElementById('hardware-drawer');
            drawer.innerHTML = '';
            hwItems.forEach(item => {
                const el = document.createElement('div');
                el.draggable = true;
                el.id = `hw-${item.id}`;
                el.dataset.id = item.id;
                el.dataset.step = item.step;
                el.className = "draggable-item bg-light-lavender border border-purple-300 p-2 rounded-xl text-center shadow-sm hover:shadow";
                el.innerHTML = `
                    <i class="fa-solid ${item.icon} ${item.color} text-2xl mb-1"></i>
                    <div class="font-bold text-[11px] text-dark-blue">${item.name}</div>
                `;
                el.addEventListener('dragstart', (e) => e.dataTransfer.setData('text/plain', item.id));
                drawer.appendChild(el);
            });
        }

        function setupHardwareDropSlots() {
            const slots = document.querySelectorAll('#level-1 .drop-slot');
            slots.forEach(slot => {
                slot.addEventListener('dragover', e => { e.preventDefault(); slot.classList.add('drag-over'); });
                slot.addEventListener('dragleave', () => slot.classList.remove('drag-over'));
                slot.addEventListener('drop', e => {
                    e.preventDefault();
                    slot.classList.remove('drag-over');
                    const itemId = e.dataTransfer.getData('text/plain');
                    const item = hwItems.find(i => i.id === itemId);

                    if (!item) return;

                    if (item.step !== level1Step) {
                        playSound('wrong');
                        addScore(-10);
                        alert(`Ошибка последовательности!\nТекущий шаг: Шаг ${level1Step}. Нельзя ставить ${item.name} раньше времени!`);
                        return;
                    }

                    if (item.id === "thermal") {
                        thermalPasteApplied = true;
                        document.getElementById('thermal-paste-status').innerText = "Термопаста: НАНЕСЕНА ✓";
                        document.getElementById('thermal-paste-status').className = "text-emerald-400 font-bold";
                    }

                    playSound('correct');
                    addScore(25);

                    document.getElementById(`hw-${item.id}`).classList.add('placed');
                    
                    level1Step++;
                    if (level1Step <= 8) {
                        const nextItem = hwItems.find(i => i.step === level1Step);
                        document.getElementById('assembly-step-indicator').innerText = `Шаг ${level1Step} из 8: Установка ${nextItem.name}`;
                    } else {
                        setTimeout(() => {
                            alert("Отлично! Системный блок полностью и правильно собран с соблюдением всех правил! Переходим к Матрице памяти.");
                            startLevel2();
                        }, 400);
                    }
                });
            });
        }

        // LEVEL 2 LOGIC
        const matrixCards = [
            { id: "m1", name: "Оперативная память (ОЗУ)", loc: "internal", vol: "volatile" },
            { id: "m2", name: "Кэш-память L1/L2/L3", loc: "internal", vol: "volatile" },
            { id: "m3", name: "ПЗУ (BIOS / UEFI)", loc: "internal", vol: "non-volatile" },
            { id: "m4", name: "Память CMOS (Дата/Время)", loc: "internal", vol: "non-volatile" },
            { id: "m5", name: "NVMe M.2 SSD", loc: "internal", vol: "non-volatile" },
            { id: "m6", name: "Жесткий диск (HDD)", loc: "internal", vol: "non-volatile" },
            { id: "m7", name: "USB-Флешка", loc: "external", vol: "non-volatile" },
            { id: "m8", name: "Внешний HDD накопитель", loc: "external", vol: "non-volatile" },
            { id: "m9", name: "Карта памяти MicroSD", loc: "external", vol: "non-volatile" },
            { id: "m10", name: "Оптический диск DVD-R", loc: "external", vol: "non-volatile" }
        ];

        let matrixPlaced = 0;

        function startLevel2() {
            currentLevel = 2;
            document.getElementById('level-display').innerText = "2 / 5";
            document.getElementById('level-1').classList.add('hidden');
            document.getElementById('level-2').classList.remove('hidden');

            renderMatrixDrawer();
            setupMatrixDropSlots();
        }

        function renderMatrixDrawer() {
            const drawer = document.getElementById('matrix-cards-drawer');
            drawer.innerHTML = '';
            matrixCards.forEach(card => {
                const el = document.createElement('div');
                el.draggable = true;
                el.id = `card-${card.id}`;
                el.dataset.id = card.id;
                el.className = "draggable-item bg-light-lavender border border-purple-300 p-2 rounded-lg text-xs font-bold text-dark-blue flex justify-between items-center";
                el.innerHTML = `<span>${card.name}</span> <i class="fa-solid fa-grip-vertical text-purple-400"></i>`;
                el.addEventListener('dragstart', e => e.dataTransfer.setData('text/plain', card.id));
                drawer.appendChild(el);
            });
        }

        function setupMatrixDropSlots() {
            const slots = document.querySelectorAll('#level-2 .drop-slot');
            slots.forEach(slot => {
                slot.addEventListener('dragover', e => { e.preventDefault(); slot.classList.add('drag-over'); });
                slot.addEventListener('dragleave', () => slot.classList.remove('drag-over'));
                slot.addEventListener('drop', e => {
                    e.preventDefault();
                    slot.classList.remove('drag-over');
                    const cardId = e.dataTransfer.getData('text/plain');
                    const card = matrixCards.find(c => c.id === cardId);

                    if (!card) return;

                    const expectedLoc = slot.dataset.loc;
                    const expectedVol = slot.dataset.vol;

                    if (card.loc === expectedLoc && card.vol === expectedVol) {
                        playSound('correct');
                        addScore(20);
                        
                        const cardEl = document.getElementById(`card-${card.id}`);
                        cardEl.draggable = false;
                        cardEl.className = "bg-emerald-100 text-emerald-900 border border-emerald-300 p-1 rounded text-[10px] font-bold";
                        slot.querySelector('.matrix-list').appendChild(cardEl);

                        matrixPlaced++;
                        if (matrixPlaced === matrixCards.length) {
                            setTimeout(() => {
                                alert("Матрица памяти заполнена без ошибок! Переходим к Иерархии скорости.");
                                startLevel3();
                            }, 400);
                        }
                    } else {
                        playSound('wrong');
                        addScore(-5);
                        alert(`Ошибка классификации!\nУстройство "${card.name}" не принадлежит этой ячейке.`);
                    }
                });
            });
        }

        // LEVEL 3 LOGIC
        const speedItems = [
            { id: "s1", name: "Регистры / Кэш L1 ЦП", rank: 1 },
            { id: "s2", name: "ОЗУ (DDR5 RAM)", rank: 2 },
            { id: "s3", name: "NVMe M.2 SSD", rank: 3 },
            { id: "s4", name: "SATA HDD Диск", rank: 4 },
            { id: "s5", name: "USB 3.0 Флешка", rank: 5 }
        ];

        function startLevel3() {
            currentLevel = 3;
            document.getElementById('level-display').innerText = "3 / 5";
            document.getElementById('level-2').classList.add('hidden');
            document.getElementById('level-3').classList.remove('hidden');

            renderSpeedDrawer();
            setupSpeedDropSlots();
        }

        function renderSpeedDrawer() {
            const drawer = document.getElementById('speed-items-drawer');
            drawer.innerHTML = '';
            speedItems.forEach(item => {
                const el = document.createElement('div');
                el.draggable = true;
                el.id = `speed-${item.id}`;
                el.dataset.id = item.id;
                el.className = "draggable-item bg-light-lavender border border-purple-300 px-3 py-1.5 rounded-lg text-xs font-bold text-dark-blue";
                el.innerText = item.name;
                el.addEventListener('dragstart', e => e.dataTransfer.setData('text/plain', item.id));
                drawer.appendChild(el);
            });
        }

        function setupSpeedDropSlots() {
            const slots = document.querySelectorAll('#level-3 .speed-slot');
            slots.forEach(slot => {
                slot.addEventListener('dragover', e => e.preventDefault());
                slot.addEventListener('drop', e => {
                    e.preventDefault();
                    const itemId = e.dataTransfer.getData('text/plain');
                    const item = speedItems.find(s => s.id === itemId);

                    if (!item) return;

                    const slotRank = parseInt(slot.dataset.speedRank);
                    if (item.rank === slotRank) {
                        playSound('correct');
                        addScore(15);
                        slot.querySelector('.slot-content').innerText = item.name;
                        document.getElementById(`speed-${item.id}`).classList.add('hidden');
                    } else {
                        playSound('wrong');
                        addScore(-5);
                        alert("Неверный ранг скорости!");
                    }
                });
            });
        }

        function checkLevel3All() {
            const q1 = parseInt(document.getElementById('unit-q1').value);
            const q2 = parseInt(document.getElementById('unit-q2').value);
            const q3 = parseInt(document.getElementById('unit-q3').value);

            let correctCount = 0;
            if (q1 === 2048) correctCount++;
            if (q2 === 128) correctCount++;
            if (q3 === 3) correctCount++;

            if (correctCount === 3) {
                playSound('correct');
                addScore(50);
                alert("Все расчеты выполнены идеально! Переходим к Лаборатории Диагностики.");
                startLevel4();
            } else {
                playSound('wrong');
                addScore(-10);
                alert(`Проверено задач: ${correctCount}/3 верно.\nПодсказки:\n1 ГБ = 1024 МБ\n1 Байт = 8 Бит\n1 КБ = 1024 Байта`);
            }
        }

        // LEVEL 4 LOGIC
        const diagScenarios = [
            {
                title: "Сбой системного времени",
                problem: "При включении компьютера каждый раз сбивается дата и время, а BIOS просит сбросить настройки.",
                options: [
                    { text: "Заменить батарейку CR2032 памяти CMOS", correct: true },
                    { text: "Заменить оперативную память ОЗУ", correct: false },
                    { text: "Поменять жесткий диск", correct: false }
                ]
            },
            {
                title: "Зависание при многозадачности",
                problem: "При открытии 25 вкладок в браузере ПК начитает резко тормозить.",
                options: [
                    { text: "Не хватает объема Оперативной памяти (ОЗУ)", correct: true },
                    { text: "Сломался блок питания", correct: false },
                    { text: "Переполнен кэш процессора", correct: false }
