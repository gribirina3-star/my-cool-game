            },
            {
                title: "Медленная загрузка системы",
                problem: "Компьютер загружает Windows почти 4 минуты, а программы открываются очень долго со слышимым треском.",
                options: [
                    { text: "Заменить устаревший HDD на быстрый NVMe SSD", correct: true },
                    { text: "Поставить больше кулеров", correct: false },
                    { text: "Заменить материнскую плату", correct: false }
                ]
            },
            {
                title: "Перегрев и выключение ПК",
                problem: "Через 5 минут после запуска игры компьютер резко выключается, а радиатор кулера очень горячий.",
                options: [
                    { text: "Заменить засохшую термопасту и очистить кулер", correct: true },
                    { text: "Увеличить размер файла подкачки", correct: false },
                    { text: "Переустановить операционную систему", correct: false }
                ]
            },
            {
                title: "Потеря несохраненного документа",
                problem: "Пользователь набрал текст в Word, но выключили свет. Документ пропал. В какой памяти он находился?",
                options: [
                    { text: "В энергозависимой оперативной памяти (ОЗУ)", correct: true },
                    { text: "В постоянной памяти ПЗУ", correct: false },
                    { text: "На флеш-накопителе", correct: false }
                ]
            }
        ];

        let diagIndex = 0;

        function startLevel4() {
            currentLevel = 4;
            document.getElementById('level-display').innerText = "4 / 5";
            document.getElementById('level-3').classList.add('hidden');
            document.getElementById('level-4').classList.remove('hidden');

            renderDiagScenario();
        }

        function renderDiagScenario() {
            if (diagIndex >= diagScenarios.length) {
                alert("Диагностика завершена! Все поломки устранены. Переходим к Эко-этапу 'Таза Қазақстан'.");
                startLevel5();
                return;
            }

            const sc = diagScenarios[diagIndex];
            document.getElementById('diag-step-counter').innerText = `Сценарий ${diagIndex + 1} из ${diagScenarios.length}`;
            document.getElementById('diag-title').innerText = sc.title;
            document.getElementById('diag-problem').innerText = sc.problem;

            const optsContainer = document.getElementById('diag-options-container');
            optsContainer.innerHTML = '';

            sc.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "btn-blue p-3 rounded-xl text-left font-bold hover:bg-blue-900 transition";
                btn.innerText = `${idx + 1}. ${opt.text}`;
                btn.onclick = () => {
                    if (opt.correct) {
                        playSound('correct');
                        addScore(25);
                    } else {
                        playSound('wrong');
                        addScore(-5);
                        alert("Неверное решение инженерной проблемы!");
                    }
                    diagIndex++;
                    renderDiagScenario();
                };
                optsContainer.appendChild(btn);
            });
        }

        // LEVEL 5 LOGIC
        const ecoItems = [
            { id: "e1", name: "Вздувшийся Li-Ion аккумулятор", bin: "ewaste" },
            { id: "e2", name: "Ртутная лампа подсветки старого монитора", bin: "ewaste" },
            { id: "e3", name: "Свинцовые батареи ИБП", bin: "ewaste" },
            { id: "e4", name: "Рабочие планки DDR3 для передачи в школу", bin: "recycle" },
            { id: "e5", name: "Металлический корпус системного блока", bin: "recycle" },
            { id: "e6", name: "Кэш браузера и временные файлы .tmp", bin: "digital" },
            { id: "e7", name: "Файлы-дубликаты и спам в почте", bin: "digital" }
        ];

        let ecoPlaced = 0;

        function startLevel5() {
            currentLevel = 5;
            document.getElementById('level-display').innerText = "5 / 5";
            document.getElementById('level-4').classList.add('hidden');
            document.getElementById('level-5').classList.remove('hidden');

            renderEcoDrawer();
            setupEcoDropSlots();
        }

        function renderEcoDrawer() {
            const drawer = document.getElementById('eco-items-drawer');
            drawer.innerHTML = '';
            ecoItems.forEach(item => {
                const el = document.createElement('div');
                el.draggable = true;
                el.id = `eco-${item.id}`;
                el.dataset.id = item.id;
                el.className = "draggable-item bg-light-lavender border border-purple-300 px-3 py-1.5 rounded-lg text-xs font-bold text-dark-blue";
                el.innerText = item.name;
                el.addEventListener('dragstart', e => e.dataTransfer.setData('text/plain', item.id));
                drawer.appendChild(el);
            });
        }

        function setupEcoDropSlots() {
            const bins = document.querySelectorAll('#level-5 .drop-slot');
            bins.forEach(bin => {
                bin.addEventListener('dragover', e => e.preventDefault());
                bin.addEventListener('drop', e => {
                    e.preventDefault();
                    const itemId = e.dataTransfer.getData('text/plain');
                    const item = ecoItems.find(i => i.id === itemId);

                    if (!item) return;

                    if (item.bin === bin.dataset.bin) {
                        playSound('correct');
                        addScore(20);
                        
                        const itemEl = document.getElementById(`eco-${item.id}`);
                        itemEl.draggable = false;
                        itemEl.className = "bg-emerald-100 text-emerald-800 p-1 rounded text-[10px] font-bold";
                        bin.querySelector('.bin-list').appendChild(itemEl);

                        ecoPlaced++;
                        if (ecoPlaced === ecoItems.length) {
                            setTimeout(() => {
                                finishGame();
                            }, 500);
                        }
                    } else {
                        playSound('wrong');
                        addScore(-5);
                        alert("Неправильный контейнер утилизации!");
                    }
                });
            });
        }

        // FINISH & CERTIFICATE LOGIC
        function finishGame() {
            clearInterval(timerInterval);
            document.getElementById('level-5').classList.add('hidden');
            document.getElementById('final-screen').classList.remove('hidden');

            const totalSpent = (20 * 60) - timerSeconds;
            const m = Math.floor(totalSpent / 60);
            const s = totalSpent % 60;

            // Fill Student Certificate Details
            document.getElementById('cert-student-name').innerText = studentName;
            document.getElementById('cert-student-class').innerText = studentClass;
            document.getElementById('cert-score').innerText = score;
            document.getElementById('cert-time').innerText = `${m} мин ${s} сек`;
            
            const now = new Date();
            const dateStr = now.toLocaleDateString('ru-RU');
            document.getElementById('cert-date').innerText = dateStr;

            let rank = "Системный Инженер 1 Категории";
            if (score < 200) rank = "Младший Специалист ПК";
            else if (score < 350) rank = "Сертифицированный IT-Мастер";

            document.getElementById('cert-rank').innerText = rank;
        }
    </script>
</body>
</html>
